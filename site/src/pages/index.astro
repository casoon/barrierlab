---
import { Button, Facts, Features, Hero, Install } from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';
---

<Base>
  <Hero
    layout="editorial"
    title="Eine Antwort statt vier."
    lead="BarrierLab ist die gemeinsame Prüf-Engine hinter den CASOON-Audit-Werkzeugen: Zugänglichkeitsregeln nach WCAG 2.2, HTML-Konformanz, Wahrnehmung und Web-Checks als Rust-Bibliotheken. Ob eine Seite beim Astro-Build, im Terminal-Audit oder live im Browser geprüft wird — der Befund heißt überall gleich und bedeutet dasselbe."
  >
    <Install
      commands={[
        { label: 'Rust', command: 'cargo add a11y-rules a11y-dom a11y-report' },
        { label: 'npm', command: 'npm i @casoon/a11y-wasm' },
      ]}
    />
    <div slot="output">
      <Diagram
        name="architektur"
        format="svg"
        narrow={{ width: 380, height: 560, spec: 'architektur-schmal' }}
      />
    </div>
  </Hero>

  <Features
    heading="Für wen das ist"
    items={[
      {
        title: 'Wer Prüfwerkzeuge baut',
        body: 'Ein Werkzeug, das Webseiten auf Barrieren oder HTML-Fehler prüft, muss die Regeln nicht selbst schreiben. Es liefert das Dokument, BarrierLab rechnet — in Rust oder als WebAssembly im Browser.',
      },
      {
        title: 'Wer die Ergebnisse liest',
        body: 'Ein Bericht aus der Build-Pipeline und einer aus dem Browser lassen sich nebeneinanderlegen, ohne zu übersetzen: gleiche Regelkennung, gleicher Schweregrad, gleiches JSON aus a11y-report.',
      },
      {
        title: '„Lief nicht“ ist nicht „bestanden“',
        body: 'Fehlt einer Prüfung ihre Voraussetzung — kein Accessibility-Tree, kein Fokus, keine Darstellung —, steht sie mit Grund im Bericht. Ein stilles Bestanden gibt es nicht.',
      },
      {
        title: 'Widersprüche fallen auf',
        body: 'Zwei Werkzeuge mit zwei Kopien derselben Prüfung sagten an derselben Seite Gegenteiliges. Eine gemeinsame Implementierung macht solche Fälle sichtbar, statt sie zu verteilen.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '15', label: 'Rust-Crates, alle auf crates.io' },
      { value: '4', label: 'Werkzeuge, die sie heute einbinden' },
      { value: '3', label: 'Regelstufen: Struktur, Semantik, Darstellung' },
      { value: '1', label: 'Befundmodell für alle Pakete' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">So hängt es zusammen</h2>
    <div class="text">
      <p>
        Hier liegen nur Bibliotheken. Keine davon öffnet eine Seite oder spricht ein
        Browserprotokoll: Das Werkzeug beschafft die Daten, BarrierLab rechnet. Deshalb läuft
        derselbe Regelbestand im Terminal, nach dem Build und als WebAssembly in der geöffneten
        Seite.
      </p>
      <p>
        Die Werkzeuge leben in eigenen Repositories und binden die Pakete über crates.io und npm
        ein: auditmysite prüft gerenderte Seiten im Terminal, astro-post-audit das fertige
        Astro-Build, liveaudit die laufende Seite, und Relief nutzt Regeln und Wahrnehmung im
        eigenen Browser.
      </p>
    </div>
    <div class="links">
      <Button href={url('docs/a11y/getting-started/schnellstart/')}>Schnellstart in Rust</Button>
      <Button href={url('docs/packages/')} variant="secondary">Alle Pakete im Überblick</Button>
      <Button href={url('docs/html-conform/')} variant="quiet">HTML-Konformanz →</Button>
    </div>
  </section>
</Base>

<style>
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
